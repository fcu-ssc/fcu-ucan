@model UserInviteViewModel
@{
    ViewData["Title"] = "邀請使用者";
}

<section class="section is-medium">
    <div class="container is-max-desktop">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="Manage" asp-action="Index">管理</a></li>
                <li><a asp-controller="User" asp-action="Index">使用者</a></li>
                <li class="is-active"><a asp-controller="User" asp-action="Invite" aria-current="page">@ViewData["Title"]</a></li>
            </ul>
        </nav>
        <div class="box content">
            <h1 class="title is-3">@ViewData["Title"]</h1>
            <hr/>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] is not null)
            {
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div class="notification is-danger">
                        <button class="delete"></button>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }
            <form asp-controller="User" asp-action="Invite" method="post" role="form">
                <div class="field mb-5">
                    <label asp-for="UserName" class="label">帳號</label>
                    <div class="control has-icons-left">
                        <input asp-for="UserName" class="input" type="text" placeholder="請輸入帳號"/>
                        <span class="icon is-small is-left">
                            <i class="fas fa-user"></i>
                        </span>
                    </div>
                    <span asp-validation-for="UserName" class="help is-danger"></span>
                </div>
                <div class="field mb-5">
                    <label asp-for="Email" class="label">電子郵件</label>
                    <div class="control has-icons-left">
                        <input asp-for="Email" class="input" type="email" placeholder="請輸入電子郵件"/>
                        <span class="icon is-small is-left">
                            <i class="far fa-envelope"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Email" class="help is-danger"></span>
                </div>
                <div class="field mb-5">
                    <label asp-for="Password" class="label">密碼</label>
                    <div class="control has-icons-left">
                        <input asp-for="Password" class="input" type="password" placeholder="請輸入密碼"/>
                        <span class="icon is-small is-left">
                            <i class="fas fa-lock"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="help is-danger"></span>
                </div>
                <div class="field mb-5">
                    <label asp-for="ConfirmPassword" class="label">確認密碼</label>
                    <div class="control has-icons-left">
                        <input asp-for="ConfirmPassword" class="input" type="password" placeholder="請輸入確認密碼"/>
                        <span class="icon is-small is-left">
                            <i class="fas fa-lock"></i>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="help is-danger"></span>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-link" type="submit">邀請</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}